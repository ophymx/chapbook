/target
/fixtures/corpus/
.DS_Store
**/*.pending-snap

# Local tooling config: kept on disk, not published.
/CLAUDE.md
/.claude/

# Android spike: machine paths, build output, and the Rust .so cargo-ndk
# writes into the library module.
/android/local.properties
/android/.gradle/
/android/build/
/android/*/build/
/android/chapbook/src/main/jniLibs/
/android/demo/src/main/assets/

# iOS: Rust-built framework slices and app build output; SwiftPM state.
/ios/Chapbook/Chapbook.xcframework/
/ios/Chapbook/.build/
/ios/demo/build/
/ios/App/.build/
/ios/App/build/

# Windows: MSBuild's per-project output, and the native DLL that
# `build-native.ps1` copies beside a package. The DLL is a build product of
# the Rust workspace like every other one, not an artifact to check in.
/windows/**/bin/
/windows/**/obj/
/windows/**/runtimes/

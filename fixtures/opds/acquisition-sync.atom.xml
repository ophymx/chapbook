<?xml version="1.0" encoding="UTF-8"?>
<!--
  An acquisition feed whose entry advertises both sync services, which no
  other OPDS fixture here does. It exists for the download-request path:
  the progression endpoint and the annotation container live in the
  catalog entry and nowhere else, so a host whose transfer outlives the
  feed has to read them before it starts — and that is only testable
  against an entry that carries them.

  The progression href is root-relative on purpose. Real catalogs serve
  it that way, and an unresolved one would reach the library as a path
  rather than a URL. The annotation container is absolute, so the same
  test covers both sides of the resolve.

  The title carries a separator and a colon so a suggested filename is
  observably one safe path component rather than a path.
-->
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:opds="http://opds-spec.org/2010/catalog" xmlns:dcterms="http://purl.org/dc/terms/">
  <id>urn:cat:sync</id>
  <title>Syncing Shelf</title>
  <updated>2026-01-02T03:04:05Z</updated>
  <author>
    <name>Library Inc</name>
  </author>
